# Copy to .env and adjust. Never commit .env.

APP_ENV=development
APP_PORT=8080

# Host ports the containers publish. Change these when 8080 or 3000 are already in use;
# NEXT_PUBLIC_API_URL and CORS_ALLOWED_ORIGINS have to match whatever you choose.
APP_HOST_PORT=8080
FRONTEND_HOST_PORT=3000

# Host and port as seen from where the backend runs.
# Local go run: localhost plus the published port below.
# Inside docker compose the backend uses sqlserver:1433 and ignores these.
DB_HOST=localhost
DB_PORT=1433

# Host port the SQL Server container publishes. Change both this and DB_PORT to
# something free, for example 1434, when the machine already runs SQL Server on 1433.
SQLSERVER_HOST_PORT=1433
DB_USER=sa
DB_PASSWORD=YourStrong@Passw0rd
DB_NAME=financial_management

# Use a long random value. Production refuses anything shorter than 32 characters.
JWT_SECRET=change-me-to-a-long-random-value-at-least-32-chars
JWT_EXPIRATION=24h

# Comma separated list of browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Read by the Next.js app at build and run time.
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
