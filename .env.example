# Copy to .env and adjust. Never commit .env.

APP_ENV=development
APP_PORT=8080

# Host ports the containers publish. Change these when 8080 or 3000 are already in use;
# NEXT_PUBLIC_API_URL and CORS_ALLOWED_ORIGINS have to match whatever you choose.
APP_HOST_PORT=8080
FRONTEND_HOST_PORT=3000

# --- Database ---------------------------------------------------------------
# DB_HOST is what the backend dials when it runs directly on this machine
# (make run, make migrate, go test).
DB_HOST=localhost
DB_PORT=5432

# DB_HOST_DOCKER is the same database as seen from inside a container, because a
# container cannot reach the host as "localhost". Leave it as the compose service
# name to use the bundled Postgres; set it to host.docker.internal to use a
# Postgres running on this machine, or to a provider's host for a managed one.
DB_HOST_DOCKER=postgres
DB_PORT_DOCKER=5432

# Host port the bundled Postgres container publishes. Change it when this machine
# already runs Postgres on 5432; DB_PORT only has to match when the backend runs
# on the host and talks to that container.
POSTGRES_HOST_PORT=5432

DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=financial_management

# disable, allow, prefer, require, verify-ca or verify-full. Hosted Postgres needs
# require; production refuses disable and allow outright.
DB_SSLMODE=disable

# Use a long random value. Production refuses anything shorter than 32 characters.
JWT_SECRET=change-me-to-a-long-random-value-at-least-32-chars
JWT_EXPIRATION=24h

# Comma separated list of browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Read by the Next.js app at build and run time.
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# --- Telegram bot -----------------------------------------------------------
# TELEGRAM_MODE: off (default), polling or webhook.
#   polling  needs no public URL and works on a laptop or behind NAT.
#   webhook  needs a public HTTPS URL that Telegram can reach, plus a secret.
# The two are mutually exclusive: the API clears the webhook when it polls.
TELEGRAM_MODE=off
TELEGRAM_BOT_TOKEN=
# Required in webhook mode. Telegram echoes it back in X-Telegram-Bot-Api-Secret-Token,
# so knowing the URL is not enough to post forged updates. Generate a long random value.
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=
# How long a pairing code stays usable.
TELEGRAM_PAIRING_CODE_TTL=15m
# Override only to point the client at a stub in tests.
TELEGRAM_API_BASE_URL=https://api.telegram.org
